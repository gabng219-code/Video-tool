<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>AI Video Transcriber - Free Text Extraction</title>
  <meta name="description" content="Extract exact text transcripts from 1-2 minute Instagram Reels, Shorts, and MP4 videos directly in your browser.">
  <style>
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
    }
    body {
      background-color: #0d1117;
      color: #c9d1d9;
      line-height: 1.6;
      padding: 20px 15px;
    }
    .container {
      max-width: 680px;
      margin: 0 auto;
    }
    header {
      text-align: center;
      padding: 20px 0 10px;
    }
    .logo {
      font-size: 26px;
      font-weight: 800;
      color: #ffffff;
      text-decoration: none;
    }
    .logo span {
      color: #ff3366;
    }
    h1 {
      font-size: 24px;
      color: #ffffff;
      margin: 15px 0 5px;
    }
    .tool-box {
      background: #161b22;
      border: 1px solid #30363d;
      border-radius: 12px;
      padding: 20px;
      margin-bottom: 20px;
      box-shadow: 0 8px 24px rgba(0, 0, 0, 0.2);
    }
    input[type="file"] {
      width: 100%;
      padding: 10px;
      background: #0d1117;
      border: 1px solid #30363d;
      border-radius: 8px;
      color: #fff;
      margin-bottom: 12px;
    }
    button.btn-main {
      width: 100%;
      background: #ff3366;
      color: #fff;
      border: none;
      padding: 14px;
      font-size: 16px;
      font-weight: 700;
      border-radius: 8px;
      cursor: pointer;
    }
    button.btn-main:disabled {
      background: #5c1c2e;
      cursor: not-allowed;
    }
    #status {
      margin-top: 15px;
      font-size: 14px;
      color: #f0c33c;
      font-weight: bold;
      text-align: center;
    }
    textarea {
      width: 100%;
      padding: 14px;
      background: #0d1117;
      border: 1px solid #30363d;
      border-radius: 8px;
      color: #fff;
      font-size: 15px;
      outline: none;
      resize: vertical;
      height: 150px;
      margin-top: 15px;
    }
    footer {
      text-align: center;
      margin-top: 35px;
      padding: 20px 0;
      font-size: 12px;
      color: #6e7681;
    }
  </style>
</head>
<body>

  <div class="container">
    <header>
      <a href="index.html" class="logo">Video<span>Tools</span></a>
      <h1>AI Video Transcriber</h1>
      <p style="color:#8b949e; font-size:13px;">Upload an MP4 video (up to 2 mins / 30MB) to generate text.</p>
    </header>

    <div class="tool-box">
      <input type="file" id="videoInput" accept="video/mp4,video/webm,video/quicktime">
      <button id="startBtn" class="btn-main">Generate Transcript</button>
      
      <div id="status"></div>
      
      <textarea id="resultBox" placeholder="Your video transcript will appear here..." readonly></textarea>
    </div>
    <div style="background: #161b22; border: 1px solid #30363d; padding: 20px; border-radius: 12px; margin-bottom: 20px;">
      <h2 style="color: #ffffff; font-size: 20px; margin-bottom: 10px;">🎙️ AI Video Transcriber</h2>
      <p style="color: #8b949e; font-size: 14px; margin-bottom: 15px;">Extract the exact English text script directly from any short video.</p>
      <a href="transcriber.html" style="display: inline-block; background: #ff3366; color: #ffffff; text-decoration: none; padding: 12px 20px; border-radius: 8px; font-weight: bold;">Open Transcriber</a>
    </div>

    <footer>
      <p>&copy; 2026 VideoTools Utility.</p>
    </footer>
  </div>

  <script type="module">
    import { pipeline, env } from 'https://cdn.jsdelivr.net/npm/@xenova/transformers@2.17.1';
    
    // Disable local model checking since we are on browser
    env.allowLocalModels = false;

    const startBtn = document.getElementById('startBtn');
    const statusDiv = document.getElementById('status');
    const resultBox = document.getElementById('resultBox');
    const videoInput = document.getElementById('videoInput');

    startBtn.addEventListener('click', async () => {
      const file = videoInput.files[0];
      if (!file) {
        alert("Please select a video file first.");
        return;
      }

      // Check file size (max 30MB for safety on mobile)
      if (file.size > 30 * 1024 * 1024) {
        alert("File is too large! Please upload a video under 30MB (approx 2 mins).");
        return;
      }

      startBtn.disabled = true;
      resultBox.value = "";
      
      try {
        statusDiv.innerText = "⏳ Loading AI Model (Requires ~40MB data on first run)...";
        
        // Load the AI model
        const transcriber = await pipeline('automatic-speech-recognition', 'Xenova/whisper-tiny.en');
        
        statusDiv.innerText = "⚙️ Extracting Audio from Video...";
        const arrayBuffer = await file.arrayBuffer();
        
        // Decode audio data using browser's AudioContext
        const audioContext = new (window.AudioContext || window.webkitAudioContext)({ sampleRate: 16000 });
        const audioBuffer = await audioContext.decodeAudioData(arrayBuffer);
        const audioData = audioBuffer.getChannelData(0); 

        statusDiv.innerText = "🎙️ AI is transcribing... (This may take 1-2 minutes on mobile)";
        
        // Run Whisper AI
        const output = await transcriber(audioData, {
          chunk_length_s: 30,
          stride_length_s: 5,
        });

        resultBox.value = output.text;
        statusDiv.innerText = "✅ Complete!";
        statusDiv.style.color = "#238636";

      } catch (error) {
        console.error(error);
        statusDiv.innerText = "❌ Error processing video. Try a shorter video.";
        statusDiv.style.color = "#ff3366";
      } finally {
        startBtn.disabled = false;
      }
    });
  </script>
</body>
</html>
